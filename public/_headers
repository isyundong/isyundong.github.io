# Cloudflare Pages headers. The shared design system is loaded by other sites
# (*.zhang.stream, ipscaner.com), so its stylesheet and fonts must allow cross-origin use.
/ds/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/ds/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
