---
import Base from '../layouts/Base.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import { site, projects } from '../data/site';
---

<Base>
  <header class="hero">
    <ShaderBackground />
    <div class="hero-inner">
      <p class="zs-label kicker">Software engineer</p>
      <h1>Yundong Zhang</h1>
      <p class="lede">
        I like learning new things, tinkering with electronics, and helping build a decentralized internet.
        Outside of work: Dota 2, music, art, and this world we live in.
      </p>
      <div class="zs-row">
        <a class="zs-btn zs-btn--primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="zs-btn on-shader" href={site.github} rel="noopener">GitHub</a>
      </div>
    </div>
  </header>

  <h2 id="projects">Projects</h2>
  <div class="zs-grid">
    {projects.map((p) => (
      <article class="zs-card">
        <div class="zs-card-head">
          <h3 class="zs-card-title">{p.name}</h3>
          <span class="zs-badge zs-badge--secondary">{p.tag}</span>
          <span class="zs-end"><span class={`zs-status zs-status--${p.status}`}>{p.statusLabel}</span></span>
        </div>
        <p class="desc">{p.description}</p>
        <a class="zs-btn zs-btn--primary" href={p.url} rel="noopener">Open {p.host}</a>
      </article>
    ))}
  </div>

  <h2 id="contact">Contact</h2>
  <dl class="zs-kv contact">
    <dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
    <dt>GitHub</dt><dd><a href={site.github} rel="noopener">github.com/isyundong</a></dd>
  </dl>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: 40px;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--foreground) 10%, transparent);
    touch-action: pan-y;
  }
  .hero-inner { position: relative; z-index: 1; padding: 48px 28px 32px; max-width: 580px; }
  .kicker { margin: 0; }
  .hero h1 { margin: 2px 0 0; }
  .lede { margin: 10px 0 16px; }
  .on-shader { background: var(--card); }
  .desc { margin: 0 0 12px; color: var(--muted-foreground); }
  .contact { margin-top: 16px; }
  @media (max-width: 640px) {
    .hero { margin-top: 24px; }
    .hero-inner { padding: 28px 16px 20px; }
  }
</style>
