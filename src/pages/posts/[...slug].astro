---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const date = post.data.date.toISOString().slice(0, 10);
const minutes = Math.max(1, Math.round((post.body ?? '').length / 500));
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
---

<Base title={post.data.title} description={post.data.description} sections={sections}>
  <article>
    <header class="zs-top">
      <h1>{post.data.title}</h1>
      <p class="zs-meta">
        <time datetime={post.data.date.toISOString()}>{date}</time> · 约 {minutes} 分钟
        {post.data.tags.length > 0 && <span class="tags">{post.data.tags.map((t) => <span class="zs-badge zs-badge--outline">{t}</span>)}</span>}
      </p>
    </header>
    <div class="zs-prose">
      <Content />
    </div>
    <nav class="pager" aria-label="上一篇和下一篇">
      {older ? <a href={`/posts/${older.id}/`}><span class="zs-label">上一篇</span>{older.data.title}</a> : <span />}
      {newer ? <a class="next" href={`/posts/${newer.id}/`}><span class="zs-label">下一篇</span>{newer.data.title}</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .tags { display: inline-flex; flex-wrap: wrap; gap: 4px; margin-left: 8px; vertical-align: 1px; }
  .pager { margin-top: 64px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pager a { display: block; padding: 10px 12px; color: var(--foreground); text-decoration: none; box-shadow: inset 0 0 0 1px var(--border); min-width: 0; font-family: var(--font-heading); font-weight: 700; }
  .pager a:hover { background: var(--muted); }
  .pager a.next { text-align: right; grid-column: 2; }
  .pager .zs-label { display: block; font-family: var(--font-mono); font-weight: 400; }
</style>
