---
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { albums } from '../data/site';
---

<Base title="照片" description="张云东拍的照片。" sections={albums.map((a) => ({ id: a.slug, label: a.title }))}>
  <header class="zs-top">
    <h1>照片</h1>
    <p class="zs-meta">随手拍的，按相册放。</p>
  </header>
  {albums.map((album) => (
    <section>
      <h2 id={album.slug}>{album.title}</h2>
      <p class="zs-meta">{album.location} · {album.date} · {album.camera}</p>
      <PhotoGrid albums={[album]} />
    </section>
  ))}
</Base>
