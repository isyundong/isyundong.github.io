---
import type { Album } from '../data/site';

interface Props {
  albums: Album[];
  limit?: number;
}

const { albums, limit } = Astro.props;
const items = albums.flatMap((a) => a.photos.map((p) => ({ ...p, album: a })));
const shown = limit ? items.slice(0, limit) : items;
---

<div class="zs-photos">
  {shown.map((p) => (
    <figure class="zs-photo">
      <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
      <figcaption>
        <span>{p.album.title} · {p.album.location}</span>
        <span class="zs-meta">{p.album.date}</span>
      </figcaption>
    </figure>
  ))}
</div>
