---
import { projects } from '../data/site';
---

<div class="zs-grid">
  {projects.map((p) => (
    <article class="zs-card">
      <div class="zs-card-head">
        <h3 class="zs-card-title">{p.name}</h3>
        <span class="zs-badge zs-badge--secondary">{p.tag}</span>
        <span class="zs-end"><span class={`zs-status zs-status--${p.status}`}>{p.statusLabel}</span></span>
      </div>
      <p class="desc">{p.description}</p>
      <div class="zs-row">
        <a class="zs-btn zs-btn--primary" href={p.url} rel="noopener">打开 {p.host}</a>
      </div>
    </article>
  ))}
</div>

<style>
  .desc { margin: 0 0 12px; color: var(--muted-foreground); }
</style>
